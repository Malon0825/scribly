{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scribly",
  "version": "1.3.17",
  "identifier": "com.still.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scribly",
        "width": 1440,
        "height": 920,
        "minWidth": 850,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "A calm, local-first notebook",
    "resources": {
      "resources/postgres/": "postgres/",
      "resources/THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt",
      "../public/font-licenses.txt": "FONT-LICENSES.txt",
      "../public/import-licenses.txt": "IMPORT-LICENSES.txt",
      "../public/board-licenses.txt": "BOARD-LICENSES.txt",
      "../public/animated-icons-licenses.txt": "ANIMATED-ICONS-LICENSES.txt",
      "../public/brand-logo-licenses.txt": "BRAND-LOGO-LICENSES.txt"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}

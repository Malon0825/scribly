{
  "name": "scribly",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-rust.ps1",
    "postinstall": "node scripts/patch-excalidraw.mjs && node scripts/prepare-dictionary.mjs",
    "dev": "vite --host 127.0.0.1",
    "prepare:logos": "node scripts/prepare-brand-logos.mjs",
    "prebuild": "node scripts/prepare-brand-logos.mjs --if-needed && node scripts/prepare-dictionary.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "playwright test",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "predev": "node scripts/prepare-dictionary.mjs"
  },
  "dependencies": {
    "@animateicons/react": "0.10.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/itim": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-select": "^2.3.7",
    "@tauri-apps/api": "^2.8.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.6.0",
    "@tiptap/extension-task-item": "^3.6.0",
    "@tiptap/extension-task-list": "^3.6.0",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.6.0",
    "@tiptap/starter-kit": "^3.6.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "mermaid": "11.17.2",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "1.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"

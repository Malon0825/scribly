  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "thesvg": "3.3.12",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wordnet-db": "3.1.14"
